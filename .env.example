# ── Banco de dados ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://USER:PASSWORD@host:27017/DB?authSource=admin&replicaSet=...

# ── Servidor ────────────────────────────────────────────────────────────────────
PORT=3000

# ── JWT — gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=substitua_por_um_segredo_aleatorio_min_32_chars
JWT_EXPIRES_IN=24h

# ── Swagger (opcional — padrão: http://localhost:PORT)
API_BASE_URL=http://localhost:3000

# ── CORS (opcional — padrão: *)
CORS_ORIGIN=*
